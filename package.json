{
  "name": "sinif-asistani",
  "version": "1.0.56",
  "description": "Sınıf Asistanı - Dijital Öğretmen Yardımcısı",
  "scripts": {
    "tauri": "tauri",
    "sync": "rsync -av --delete --exclude='*.DS_Store' index.html mobile.html css js manifest.json sw.js icons tanitim vercel.json version.json dist/ && rsync -av --delete --exclude='*.DS_Store' dist/ android/app/src/main/assets/",
    "dev": "npm run sync && tauri dev",
    "build": "node scripts/sync-version.js sync",
    "build:tauri": "node scripts/sync-version.js sync && tauri build",
    "version:sync": "node scripts/sync-version.js sync",
    "version:set": "node scripts/sync-version.js",
    "version:bump": "node scripts/sync-version.js"
  },
  "devDependencies": {
    "@tauri-apps/cli": "~2.11.0"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-process": "~2.3.0",
    "@tauri-apps/plugin-updater": "~2.12.0"
  }
}
